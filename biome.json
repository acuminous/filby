{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "framework/index.js",
      "framework/bin/**/*.js",
      "framework/lib/**/*.js",
      "scripts/**/*.js",
      "framework/scripts/**/*.js",
      "framework/test/**/*.js",
      "ui/bin/**/*.js",
      "ui/lib/**/*.js",
      "ui/src/**/*.ts",
      "ui/src/**/*.tsx",
      "ui/test/**/*.ts",
      "ui/test/**/*.tsx",
      "ui/vite.config.ts",
      "examples/**/*.js",
      "examples/**/*.ts"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": false
  },
  "overrides": [
    {
      "includes": [
        "examples/holiday-park/**/*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": [
        "framework/test/dsl.test.js"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noAccumulatingSpread": "off"
          }
        }
      }
    }
  ]
}
