{
  "name": "filby",
  "version": "0.14.0",
  "description": "A framework for temporal reference data",
  "keywords": [
    "temporal",
    "time",
    "travelling",
    "series",
    "reference",
    "data",
    "database",
    "postgres",
    "postgresql",
    "typescript"
  ],
  "author": "Stephen Cresswell",
  "license": "ISC",
  "engines": {
    "node": ">=22.12"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "filby": "bin/filby.js"
  },
  "directories": {
    "example": "examples",
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "docker": "docker-compose up --detach",
    "example": "docker compose up --detach --wait fby_example && npm --prefix examples/holiday-park ci && npm --prefix examples/holiday-park start",
    "lint": "biome ci .",
    "pretest": "node scripts/database.js check",
    "test": "node --require ./scripts/load-env.js --test --test-concurrency=1 test/*.test.js",
    "test:all": "docker compose up --detach --wait && (cd examples/holiday-park && npm test) && npm test",
    "precoverage": "node scripts/database.js check",
    "coverage": "mkdir -p coverage && node --require ./scripts/load-env.js --test --test-concurrency=1 --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/*.test.js",
    "db:create": "node scripts/database.js create",
    "db:drop": "node scripts/database.js drop",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eventemitter2": "^6.4.9",
    "handlebars": "^4.7.10",
    "marv": "^7.1.0",
    "marv-pg-driver": "^6.0.0",
    "papaparse": "^5.7.0",
    "parse-duration": "^2.1.9",
    "pg": "^8.23.1",
    "pipsqueak": "^3.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@types/pg": "^8.23.1",
    "lefthook": "2.2.2",
    "object-path-immutable": "^4.1.2",
    "pg-error-enum": "^2.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acuminous/filby.git"
  },
  "bugs": {
    "url": "https://github.com/acuminous/filby/issues"
  },
  "homepage": "https://acuminous.github.io/filby"
}
