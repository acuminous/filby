-- add change set
DO $$
DECLARE
  v_change_set_id INTEGER;
  v_entity_id INTEGER;
  v_frame_id INTEGER;
BEGIN
  INSERT INTO fby_change_set (effective, description) VALUES
  ({{#if (isBareDate effective)}}{{literal effective}}::timestamp AT TIME ZONE {{literal timezone}}{{else}}{{literal effective}}{{/if}}, {{literal description}})
  RETURNING id INTO v_change_set_id;
  {{#frames}}
  {{> insert_data_frame entity=entity version=version chunks=(frameChunks this)}}

  PERFORM fby_notify_add_change_set({{literal entity}}, {{literal version}});
  {{/frames}}

  PERFORM fby_reissue_change_sets(v_change_set_id);
END;
$$ LANGUAGE plpgsql;
