-- add change set
DO $$
DECLARE
  v_change_set_id INTEGER;
  v_entity_id INTEGER;
  v_frame_id INTEGER;
BEGIN
  UPDATE fby_change_set_counter SET last_id = last_id + 1 RETURNING last_id INTO v_change_set_id;

  INSERT INTO fby_change_set (id, effective, description) VALUES
  (v_change_set_id, {{#if (isBareDate effective)}}{{literal effective}}::timestamp AT TIME ZONE {{literal timezone}}{{else}}{{literal effective}}{{/if}}, {{literal description}});
  {{#frames}}
  {{> insert_data_frame entity=entity version=version chunks=(frameChunks this)}}

  PERFORM fby_notify_add_change_set(v_change_set_id, {{literal entity}}, {{literal version}});
  {{/frames}}

  PERFORM fby_reissue_change_sets(v_change_set_id);
END;
$$ LANGUAGE plpgsql;
