-- drop projection
DO $$
DECLARE
  v_projection_id INTEGER;
  v_root_id INTEGER;
  v_dropped_at TIMESTAMP WITH TIME ZONE;
BEGIN
  SELECT id, root_entity_id, dropped_at INTO v_projection_id, v_root_id, v_dropped_at
  FROM fby_projection
  WHERE name = {{literal name}}
    AND version = {{literal version}};

  IF v_projection_id IS NULL THEN
    RAISE EXCEPTION 'Projection ''%'' does not exist', {{literal name (v version)}};
  END IF;

  IF v_dropped_at IS NOT NULL THEN
    RAISE EXCEPTION 'Projection ''%'' was already dropped', {{literal name (v version)}};
  END IF;

  DELETE FROM fby_projection_entity WHERE projection_id = v_projection_id;
  DELETE FROM fby_projection_parameter WHERE projection_id = v_projection_id;
  DELETE FROM fby_projection_order WHERE projection_id = v_projection_id;
  DELETE FROM fby_projection_nest WHERE projection_id = v_projection_id;
  DELETE FROM fby_hook WHERE projection_id = v_projection_id;

  UPDATE fby_projection
  SET root_entity_id = NULL,
      fields = NULL,
      aliases = NULL,
      page_size = NULL,
      page_max = NULL,
      dropped_at = now()
  WHERE id = v_projection_id;

  DELETE FROM fby_notification
  WHERE projection_name = {{literal name}}
    AND projection_version = {{literal version}};

  IF v_root_id IS NOT NULL THEN
    EXECUTE format('DROP FUNCTION %I', {{literal (projectionFunction name version)}});
  END IF;

  PERFORM fby_schedule_notification(h.id, {{literal name}}, {{literal version}})
  FROM fby_hook h
  WHERE h.event = 'DROP_PROJECTION';

END;
$$ LANGUAGE plpgsql;
