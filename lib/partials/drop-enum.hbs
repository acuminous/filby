-- drop enum
DO $$
DECLARE
  v_exists BOOLEAN;
BEGIN
  SELECT EXISTS (
    SELECT 1
    FROM pg_type
      WHERE typname = {{literal name}} AND typtype = 'e'
  ) INTO v_exists;

  IF NOT v_exists THEN
    RAISE EXCEPTION 'Enum '{{literal name}}' does not exist';
  END IF;

  DROP TYPE {{identifier name}};

  DELETE FROM fby_enum WHERE name = {{literal (canonical name)}};
END;
$$ LANGUAGE plpgsql;