-- add entity
DO $$
BEGIN
  BEGIN
    INSERT INTO fby_entity (name, version, description) VALUES
    ({{literal name}}, {{literal version}}, {{literal description}});
  EXCEPTION
    WHEN unique_violation
    THEN RAISE EXCEPTION 'Entity '{{literal name (v version)}}' already exists';
  END;
END;
$$ LANGUAGE plpgsql;

INSERT INTO fby_entity_field (entity_id, position, name, type, identity, nullable)
SELECT e.id, f.position, f.name, f.type, f.identity, f.nullable
FROM fby_entity e, (VALUES
  {{#fields}}
  ({{ordinal}}, {{literal (canonical name)}}, {{fieldType ../name ../version name type}}, {{#if (includes ../identified_by this)}}TRUE{{else}}FALSE{{/if}}, {{#if nullable}}TRUE{{else}}FALSE{{/if}}){{#unless @last}},{{/unless}}
  {{/fields}}
) AS f (position, name, type, identity, nullable)
WHERE e.name = {{literal name}}
  AND e.version = {{literal version}};

{{#if checks}}
INSERT INTO fby_entity_check (entity_id, name, expression)
SELECT e.id, c.name, c.expression
FROM fby_entity e, (VALUES
  {{#each checks}}
  ({{literal @key}}, {{literal this}}){{#unless @last}},{{/unless}}
  {{/each}}
) AS c (name, expression)
WHERE e.name = {{literal name}}
  AND e.version = {{literal version}};
{{/if}}

DO $$
DECLARE
  v_entity_id INTEGER;
  v_columns TEXT;
  v_outputs TEXT;
BEGIN
  SELECT id INTO v_entity_id
  FROM fby_entity
  WHERE name = {{literal name}}
    AND version = {{literal version}};

  SELECT
    string_agg(format('%I %s%s', name, type, CASE WHEN identity THEN ' NOT NULL' ELSE '' END), ', ' ORDER BY position),
    string_agg(format('%I %s', name, type), ', ' ORDER BY position)
  INTO v_columns, v_outputs
  FROM fby_entity_field
  WHERE entity_id = v_entity_id;

  EXECUTE $table$CREATE TABLE {{identifier (table name version)}} (
    fby_frame_id INTEGER PRIMARY KEY,
    fby_change_set_id INTEGER NOT NULL,
    $table$ || v_columns || $table$,
    {{frameReference this}},
    {{unique this}}{{#if checks}},{{/if}}
    {{#each checks}}
    {{check @key this}}{{#unless @last}},{{/unless}}
    {{/each}}
  )$table$;

  EXECUTE $function$CREATE FUNCTION {{identifier (aggregate name version)}}(p_change_set_id INTEGER) RETURNS TABLE ($function$ || v_outputs || $function$)
  AS $body$
    WITH specified_change_set AS (
      SELECT * FROM fby_change_set cs
      WHERE cs.id = p_change_set_id
    ), aggregated AS (
      SELECT
        DISTINCT ON ({{#identified_by}}{{identifier name}}{{#unless @last}},{{/unless}}{{/identified_by}})
        f.action AS fby_action,
        {{#fields}}x.{{identifier name}}{{#unless @last}},
        {{/unless}}{{/fields}}
      FROM
        specified_change_set scs,
        fby_data_frame f
      INNER JOIN fby_entity e ON e.id = f.entity_id
      INNER JOIN fby_change_set cs ON cs.id = f.change_set_id
      INNER JOIN {{identifier (table name version)}} x ON x.fby_frame_id = f.id
      WHERE e.name = {{literal name}}
        AND e.version = {{literal version}}
        AND f.change_set_id <= p_change_set_id
        AND cs.effective <= scs.effective
      ORDER BY
        {{#identified_by}}x.{{identifier name}} ASC,
        {{/identified_by}}
        cs.effective DESC,
        f.change_set_id DESC,
        x.fby_frame_id DESC
    )
    SELECT {{#fields}}
      a.{{identifier name}}{{#unless @last}},{{/unless}}{{/fields}}
    FROM aggregated a
    WHERE a.fby_action <> 'DELETE';
  $body$ LANGUAGE sql STABLE$function$;
END;
$$ LANGUAGE plpgsql;
