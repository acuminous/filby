SELECT id INTO v_entity_id
FROM fby_entity
WHERE name = {{literal entity}}
  AND version = {{literal version}};

IF v_entity_id IS NULL THEN
  RAISE EXCEPTION 'Change set ''%'' references a non existent entity ''%''%',
    (SELECT description FROM fby_change_set WHERE id = v_change_set_id),
    {{literal entity (v version)}},
    fby_entity_hint({{literal entity}}, {{literal version}});
END IF;
{{#each chunks}}

DECLARE
  v_rows CONSTANT json := {{literal rows}};
  v_field TEXT;
  v_row RECORD;
BEGIN
  SELECT f.name INTO v_field
  FROM unnest(ARRAY[{{#each fields}}{{literal this}}{{#unless @last}}, {{/unless}}{{/each}}]) AS f (name)
  WHERE NOT EXISTS (SELECT 1 FROM fby_entity_field ef WHERE ef.entity_id = v_entity_id AND ef.name = f.name)
  LIMIT 1;

  IF v_field IS NOT NULL THEN
    RAISE EXCEPTION 'Change set ''%'' references a non existent field ''%'' of entity ''%''',
      (SELECT description FROM fby_change_set WHERE id = v_change_set_id),
      v_field,
      {{literal ../entity (v ../version)}};
  END IF;

  FOR v_row IN SELECT e.ordinality, e.value FROM json_array_elements(v_rows) WITH ORDINALITY e ORDER BY e.ordinality LOOP
    BEGIN
      INSERT INTO fby_data_frame (change_set_id, entity_id, action)
      VALUES (v_change_set_id, v_entity_id, (v_row.value->>'action')::fby_action_type)
      RETURNING id INTO v_frame_id;

      INSERT INTO {{identifier (table ../entity ../version)}} (fby_frame_id, fby_change_set_id, {{#each fields}}{{identifier this}}{{#unless @last}}, {{/unless}}{{/each}})
      SELECT v_frame_id, v_change_set_id, {{#each fields}}{{identifier this}}{{#unless @last}}, {{/unless}}{{/each}}
      FROM json_populate_record(null::{{identifier (table ../entity ../version)}}, v_row.value->'data');
    EXCEPTION
      WHEN unique_violation
      THEN RAISE EXCEPTION 'Entity ''%'' has more than one frame with key (%) in change set ''%''',
        {{literal ../entity (v ../version)}},
        (SELECT string_agg(format('%s=%s', i.name, v_row.value->'data'->>i.name), ', ' ORDER BY i.position) FROM fby_entity_field i WHERE i.entity_id = v_entity_id AND i.identity),
        (SELECT description FROM fby_change_set WHERE id = v_change_set_id);
      WHEN OTHERS
      THEN RAISE EXCEPTION '%: % - %', {{literal @filename}}, {{literal location.prefix}} || ({{location.first}} + v_row.ordinality - 1), SQLERRM USING ERRCODE = SQLSTATE;
    END;
  END LOOP;
END;
{{/each}}
