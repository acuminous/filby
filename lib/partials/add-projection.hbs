-- add projection
DO $$
DECLARE
  v_projection_id INTEGER;
  v_entity_id INTEGER;
  v_root_id INTEGER;
  v_type TEXT;
  v_array BOOLEAN;
  v_arrays BOOLEAN[] := '{}';
  v_selection JSONB := {{literal columns}};
  v_arguments TEXT;
  v_columns TEXT;
  v_outputs TEXT;
  v_order TEXT;
  v_body TEXT;
  v_existing TEXT;
BEGIN
  SELECT name || ' v' || version INTO v_existing
  FROM fby_projection
  WHERE lower(regexp_replace(name || ' v' || version, '\s', '_', 'g')) = {{literal (table name version)}}
    AND NOT (name = {{literal name}} AND version = {{literal version}})
  LIMIT 1;

  IF v_existing IS NOT NULL THEN
    RAISE EXCEPTION 'Projection ''%'' cannot be added because projection ''%'' already exists, and both become ''%''', {{literal name (v version)}}, v_existing, {{literal (table name version)}};
  END IF;

  BEGIN
    INSERT INTO fby_projection (name, version, description) VALUES
    ({{literal name}}, {{literal version}}, {{literal description}})
    RETURNING id INTO v_projection_id;
  EXCEPTION
    WHEN unique_violation
    THEN RAISE EXCEPTION 'Projection '{{literal name (v version)}}' already exists';
  END;

  {{#dependencies}}
  SELECT id INTO v_entity_id
  FROM fby_entity
  WHERE name = {{literal entity}}
    AND version = {{literal version}};

  IF v_entity_id IS NULL THEN
    RAISE EXCEPTION 'Projection ''%'' references a non existent entity ''%''%', {{literal ../name (v ../version)}}, {{literal entity (v version)}}, fby_entity_hint({{literal entity}}, {{literal version}});
  END IF;

  INSERT INTO fby_projection_entity (projection_id, entity_id) VALUES
  (v_projection_id, v_entity_id);
  {{/dependencies}}

  {{#if root}}
  SELECT id INTO v_root_id
  FROM fby_entity
  WHERE name = {{literal root.entity}}
    AND version = {{literal root.version}};

  UPDATE fby_projection
  SET root_entity_id = v_root_id,
      fields = {{fieldArray fields 'field'}},
      aliases = {{fieldArray fields 'as'}},
      page_size = {{literal paging.page_size}},
      page_max = {{literal paging.page_max}}
  WHERE id = v_projection_id;

  {{#each parameters}}
  IF {{literal (canonical name)}} IN ('change_set_id', 'page_offset', 'page_size') THEN
    RAISE EXCEPTION 'Projection ''%'' parameter ''%'' uses a reserved name', {{literal ../name (v ../version)}}, {{literal name}};
  END IF;

  SELECT id INTO v_entity_id
  FROM fby_entity
  WHERE name = {{literal entity}}
    AND version = {{literal version}};

  IF NOT EXISTS (SELECT 1 FROM fby_entity_field WHERE entity_id = v_entity_id AND name = {{literal field}}) THEN
    RAISE EXCEPTION 'Projection ''%'' parameter ''%''{{#if nests}} path ''%''{{/if}} references a non existent field ''%'' of entity ''%''%', {{literal ../name (v ../version)}}, {{literal name}}, {{#if nests}}{{literal given.path}}, {{/if}}{{literal given.field}}, {{literal entity (v version)}}, fby_entity_field_hint(v_entity_id);
  END IF;

  SELECT COALESCE(t.typcategory = 'A', FALSE) INTO v_array
  FROM fby_entity_field f
  LEFT JOIN pg_type t ON t.oid = to_regtype(f.type)
  WHERE f.entity_id = v_entity_id
    AND f.name = {{literal field}};

  IF {{literal match}} = 'contains' AND NOT v_array THEN
    RAISE EXCEPTION 'Projection ''%'' parameter ''%'' cannot use match ''contains'' on field ''%'' because it is not an array', {{literal ../name (v ../version)}}, {{literal name}}, {{literal given.path}};
  END IF;

  IF {{literal match}} NOT IN ('in', 'contains') AND v_array THEN
    RAISE EXCEPTION 'Projection ''%'' parameter ''%'' cannot use match ''%'' on field ''%'' because it is an array', {{literal ../name (v ../version)}}, {{literal name}}, {{literal match}}, {{literal given.path}};
  END IF;

  v_arrays := v_arrays || v_array;

  INSERT INTO fby_projection_parameter (projection_id, position, name, field, match) VALUES
  (v_projection_id, {{ordinal}}, {{literal name}}, {{literal path}}, {{literal match}});

  {{/each}}
  {{#each order}}
  IF NOT EXISTS (SELECT 1 FROM fby_entity_field WHERE entity_id = v_root_id AND name = {{literal (canonical field)}}) THEN
    RAISE EXCEPTION 'Projection ''%'' orders by a non existent field ''%'' of entity ''%''%', {{literal ../name (v ../version)}}, {{literal field}}, {{literal ../root.entity (v ../root.version)}}, fby_entity_field_hint(v_root_id);
  END IF;

  INSERT INTO fby_projection_order (projection_id, position, field, direction, nulls) VALUES
  (v_projection_id, {{ordinal}}, {{literal (canonical field)}}, {{literal direction}}, {{literal nulls}});

  {{/each}}
  {{#each fields}}
  IF NOT EXISTS (SELECT 1 FROM fby_entity_field WHERE entity_id = v_root_id AND name = {{literal field}}) THEN
    RAISE EXCEPTION 'Projection ''%'' selects a non existent field ''%'' of entity ''%''%', {{literal ../name (v ../version)}}, {{literal given.field}}, {{literal ../root.entity (v ../root.version)}}, fby_entity_field_hint(v_root_id);
  END IF;

  {{/each}}
  SELECT
    string_agg(format('%I %s', COALESCE(s.item->>'as', f.name), f.type), ', ' ORDER BY s.ordinality, f.position),
    string_agg(format('a.%I', f.name), ', ' ORDER BY s.ordinality, f.position)
  INTO v_columns, v_outputs
  FROM fby_entity_field f
  LEFT JOIN jsonb_array_elements(v_selection) WITH ORDINALITY s(item, ordinality) ON s.item->>'field' = f.name
  WHERE f.entity_id = v_root_id
    AND (v_selection IS NULL OR s.item IS NOT NULL);

  SELECT {{#if order}}{{literal (projectionOrder order)}} || ', ' || {{/if}}string_agg(format('a.%I ASC', name), ', ' ORDER BY position)
  INTO v_order
  FROM fby_entity_field
  WHERE entity_id = v_root_id
    AND identity;

  v_arguments := 'p_change_set_id INTEGER';
  {{#each parameters}}

  SELECT CASE WHEN t.typcategory = 'A' THEN format_type(t.typelem, NULL) ELSE f.type END INTO v_type
  FROM fby_entity_field f
  INNER JOIN fby_entity e ON e.id = f.entity_id
  LEFT JOIN pg_type t ON t.oid = to_regtype(f.type)
  WHERE e.name = {{literal entity}}
    AND e.version = {{literal version}}
    AND f.name = {{literal field}};
  {{#each (projectionArguments this)}}

  v_arguments := v_arguments || format(', %I %s DEFAULT NULL', {{literal name}}, v_type{{#if array}} || '[]'{{/if}});
  {{/each}}
  {{/each}}
  {{#if paging}}

  v_arguments := v_arguments || ', p_page_offset INTEGER DEFAULT 0, p_page_size INTEGER DEFAULT ' || {{literal paging.page_size}};
  v_columns := v_columns || ', fby_total INTEGER';
  v_outputs := v_outputs || ', COUNT(*) OVER ()::INTEGER AS fby_total';
  {{/if}}
  {{#each nest}}
  {{> add_projection_nest projection_name=../name projection_version=../version parent_entity=../root.entity parent_version=../root.version}}
  {{/each}}

  v_body := format(
    'SELECT %s FROM %I($1) a WHERE %s ORDER BY %s%s',
    v_outputs,
    {{literal (aggregate root.entity root.version)}},
    {{projectionPredicates parameters}},
    v_order,
    {{#if paging}}{{literal (projectionLimit parameters paging)}}{{else}}''{{/if}}
  );

  EXECUTE format(
    'CREATE FUNCTION %I(%s) RETURNS TABLE (%s) AS %L LANGUAGE sql STABLE',
    {{literal (projectionFunction name version)}},
    v_arguments,
    v_columns,
    v_body
  );
  {{/if}}

  PERFORM fby_schedule_notification(h.id, {{literal name}}, {{literal version}})
  FROM fby_hook h
  WHERE h.event = 'ADD_PROJECTION';

  PERFORM fby_schedule_commencements(h.id, v_projection_id)
  FROM fby_hook h
  WHERE h.event = 'COMMENCE_CHANGE_SET'
    AND h.projection_id IS NULL;

END;
$$ LANGUAGE plpgsql;
