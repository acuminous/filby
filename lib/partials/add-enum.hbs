-- add enum
DO $$
DECLARE
  v_existing TEXT;
BEGIN
  BEGIN
    CREATE TYPE {{identifier name}} AS ENUM (
      {{#values}}
      {{literal this}}{{#unless @last}},{{/unless}}
      {{/values}}
    );
  EXCEPTION
    WHEN duplicate_object THEN
      SELECT COALESCE(given_name, name) INTO v_existing FROM fby_enum WHERE name = {{literal (canonical name)}} LIMIT 1;
      IF v_existing IS NOT NULL AND v_existing <> {{literal name}} THEN
        RAISE EXCEPTION 'Enum ''%'' cannot be added because enum ''%'' already exists, and both become ''%''', {{literal name}}, v_existing, {{literal (canonical name)}};
      END IF;
      RAISE EXCEPTION 'Enum ''%'' already exists', {{literal name}};
  END;
END;
$$ LANGUAGE plpgsql;

INSERT INTO fby_enum (name, given_name, position, value) VALUES
{{#values}}
({{literal (canonical ../name)}}, {{literal ../name}}, {{ordinal}}, {{literal this}}){{#unless @last}},{{/unless}}
{{/values}};
